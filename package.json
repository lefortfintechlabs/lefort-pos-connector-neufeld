{
  "name": "lefort-pos-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de Windows que detecta cambios (solo lectura) en SQL Server Express del POS y los envía a un webhook HTTPS.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "bin": {
    "lefort-connector": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts run --config config/connector.json",
    "start": "node dist/index.js run --config config/connector.json",
    "demo": "tsx scripts/demo.ts",
    "dev:webhook": "tsx scripts/fake-webhook.ts",
    "dev:sql": "tsx scripts/run-sql.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "luxon": "^3.7.2",
    "mssql": "^12.7.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^6.2.1"
  }
}
